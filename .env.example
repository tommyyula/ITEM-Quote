# Production: Neon/PostgreSQL connection string. Required on Vercel.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Shared administrator key required for quote list/create/update/clone/delete.
# Use a long random value and store it only in Vercel Environment Variables.
ADMIN_KEY=replace-with-a-long-random-secret

# Optional business settings
QUOTE_PREFIX=ITEM
QUOTE_TIME_ZONE=America/Los_Angeles

# Local development only. Used when DATABASE_URL is not set.
LOCAL_DB_FILE=.data/quotes.json
